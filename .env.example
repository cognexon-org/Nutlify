# Copy this file to .env.local and fill in every value. Never commit .env.local.

# Public address of the site (used for links and previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nutlify?retryWrites=true&w=majority

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay (Dashboard > Webhooks): the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

#   npm run hash-password -- "your-new-password"
# then replace the line below with the one it prints.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Long random string used to sign admin sessions (at least 32 characters)
AUTH_SECRET=

# Firebase (only used for "Continue with Google"). Firebase console > Project settings > General >
# Your apps > Web app > SDK setup and configuration > Config. These values are safe to be public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nutlify-89882.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nutlify-89882
NEXT_PUBLIC_FIREBASE_APP_ID=

# SEO (optional): verification codes from Google Search Console and Bing Webmaster Tools
# (choose the "HTML tag" method and paste only the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
